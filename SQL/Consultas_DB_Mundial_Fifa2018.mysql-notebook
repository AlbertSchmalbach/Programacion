    "content": "USE mundial_fifa_2018;\n\nINSERT INTO confederaciones (Nombre) VALUES\n('UEFA'),\n('CONMEBOL'),\n('CONCACAF'),\n('AFC'),\n('CAF');\n\nINSERT INTO Equipo (Pais, Abreviatura, Grupo, ID_Confederaciones) VALUES\n('Brasil', 'BRA', 'E', 2),\n('Alemania', 'GER', 'F', 1),\n('Argentina', 'ARG', 'D', 2),\n('México', 'MEX', 'F', 3),\n('Japón', 'JPN', 'H', 4);\n\nINSERT INTO Club (Nombre, Pais) VALUES\n('FC Barcelona', 'España'),\n('Bayern Múnich', 'Alemania'),\n('Boca Juniors', 'Argentina'),\n('América', 'México'),\n('Kashima Antlers', 'Japón');\n\nINSERT INTO Jugador (Nombre, Posicion, Edad, ID_Equipo, ID_Club) VALUES\n('Neymar Jr', 'Delantero', 26, 1, 1),\n('Toni Kroos', 'Centrocampista', 28, 2, 2),\n('Lionel Messi', 'Delantero', 31, 3, 1),\n('Hirving Lozano', 'Delantero', 23, 4, 4),\n('Shinji Kagawa', 'Centrocampista', 29, 5, 5);\n\nINSERT INTO Partido (Fecha, Estadio, Ciudad, Ronda) VALUES\n('2018-06-17', 'Luzhnikí', 'Moscú', 'Fase de grupos'),\n('2018-06-27', 'Kazán Arena', 'Kazán', 'Fase de grupos'),\n('2018-06-30', 'Kazan Arena', 'Kazán', 'Octavos de final'),\n('2018-07-02', 'Samara Arena', 'Samara', 'Octavos de final'),\n('2018-07-15', 'Luzhnikí', 'Moscú', 'Final');\n\nINSERT INTO Equipo_Partido (ID_Equipo, ID_Partido, Es_Local, Goles) VALUES\n(1, 1, 'Local', 1),   -- Brasil vs Alemania\n(2, 1, 'Visitante', 2),\n(3, 2, 'Local', 2),   -- Argentina vs México\n(4, 2, 'Visitante', 1),\n(5, 3, 'Local', 2),   -- Japón vs Brasil\n(1, 3, 'Visitante', 3),\n(2, 4, 'Local', 1),   -- Alemania vs México\n(4, 4, 'Visitante', 2),\n(3, 5, 'Local', 1),   -- Argentina vs Alemania (Final)\n(2, 5, 'Visitante', 0);\n\nSELECT * FROM Confederaciones;\nSELECT * FROM equipo;\nSELECT * FROM jugador;\nSELECT * FROM club;\nSELECT * FROM partido;\n\nSELECT Equipo.Pais, Equipo.Abreviatura, Equipo.Grupo, Confederaciones.Nombre AS Confederacion\nFROM Equipo \nJOIN Confederaciones ON Equipo.ID_Confederaciones = Confederaciones.ID_Confederaciones;\n",
