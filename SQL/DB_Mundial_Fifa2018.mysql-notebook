    "caption": "DB Notebook",
    "content": "\\about\nCREATE DATABASE mundial_fifa_2018;\nUSE mundial_fifa_2018;\nCREATE TABLE IF NOT EXISTS Confederaciones(\n  ID_Confederaciones INT NOT NULL AUTO_INCREMENT,\n  Nombre VARCHAR(45) NOT NULL,\n  PRIMARY KEY (ID_Confederaciones));\nCREATE TABLE IF NOT EXISTS Equipo(\n  ID_Equipo INT NOT NULL AUTO_INCREMENT,\n  Pais VARCHAR(100) NOT NULL,\n  Abreviatura VARCHAR(20) NOT NULL,\n  Grupo INT NOT NULL,\n  ID_Confederaciones INT NOT NULL,\n  PRIMARY KEY (ID_Equipo),\n  FOREIGN KEY (ID_Confederaciones)\n  REFERENCES Confederaciones (ID_Confederaciones));\nCREATE TABLE IF NOT EXISTS Club(\n  ID_Club INT NOT NULL AUTO_INCREMENT,\n  Nombre VARCHAR(100) NOT NULL,\n  Pais VARCHAR(100) NOT NULL,\n  PRIMARY KEY (ID_Club));\nCREATE TABLE IF NOT EXISTS Jugador(\n  ID_Jugador INT NOT NULL AUTO_INCREMENT,\n  Nombre VARCHAR(100) NOT NULL,\n  Posicion VARCHAR(50) NOT NULL,\n  Edad INT NOT NULL,\n  ID_Equipo INT NOT NULL,\n  ID_Club INT NOT NULL,\n  PRIMARY KEY (ID_Jugador),\n  FOREIGN KEY (ID_Equipo) REFERENCES Equipo(ID_Equipo),\n  FOREIGN KEY (ID_Club) REFERENCES Club(ID_Club));\nCREATE TABLE IF NOT EXISTS Partido (\n  ID_Partido INT NOT NULL AUTO_INCREMENT,\n  Fecha VARCHAR(50) NOT NULL,\n  Estadio VARCHAR(100) NOT NULL,\n  Ciudad VARCHAR(100) NOT NULL,\n  Ronda VARCHAR(50) NOT NULL,\n  PRIMARY KEY (ID_Partido));\nCREATE TABLE IF NOT EXISTS Equipo_Partido (\n  ID_Equipo INT NOT NULL,\n  ID_Partido INT NOT NULL,\n  Es_Local ENUM('Local', 'Visitante') NOT NULL,\n  Goles INT NULL,\n  PRIMARY KEY (ID_Equipo, ID_Partido),\n  FOREIGN KEY (ID_Equipo) REFERENCES Equipo (ID_Equipo),\n  FOREIGN KEY (ID_Partido)REFERENCES Partido(ID_Partido));\n",
